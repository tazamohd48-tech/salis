# Dependencies and build output, wherever they appear.
node_modules/
.vite/
dist/
build/
coverage/
.turbo/

# Secrets. `.env.example` is committed; values never are.
.env
.env.*
!.env.example

# Local tooling noise
*.log
*.local
.DS_Store
*.tsbuildinfo
app/vite.config.d.ts

# Transient agent worktrees
.claude/worktrees/

# consolidation: never track these anywhere in the monorepo
**/node_modules/
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
**/user_credentials.csv
**/dist/
# Local tooling state and the plan snapshot; never committed
.claude-flow/
.claude/reviews/
.claude/proven-config.json
.claude/.proven-config-version
SlClNe-plan/
.playwright-cli/
